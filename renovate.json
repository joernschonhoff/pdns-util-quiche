{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "pinDigests": true,
  "prConcurrentLimit": 2,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Extract quiche version from VERSION file",
      "managerFilePatterns": [
        "/^VERSION$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)$"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cloudflare/quiche",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Extract regctl version from .gitlab-ci.yml",
      "managerFilePatterns": [
        "/^\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "REGCTL_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "regclient/regclient"
    }
  ],
  "packageRules": [
    {
      "description": "quiche library - update VERSION file",
      "matchFileNames": [
        "VERSION"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "cloudflare/quiche"
      ],
      "minimumReleaseAge": "3 days",
      "commitMessageTopic": "quiche",
      "groupName": "quiche"
    },
    {
      "description": "regctl version - update REGCTL_VERSION in .gitlab-ci.yml",
      "matchFileNames": [
        ".gitlab-ci.yml"
      ],
      "matchDepNames": [
        "regclient/regclient"
      ],
      "commitMessageTopic": "regctl"
    }
  ]
}